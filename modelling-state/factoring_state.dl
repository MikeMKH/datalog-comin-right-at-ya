// Factored state: acc = 0; for (i = 0; i < 10; i++) acc += i;
//
//   pc1 ──▶ pc2 ──[i<10]──▶ pc3 ──[acc+=i]──▶ pc4
//            ▲                                  │
//            └────────────[i++]─────────────────┘
//
// Exact:    sumn(pc, i, acc)          one relation, whole states
// Factored: accv(pc, a), ival(pc, i)  one relation per variable
//           rejoined on pc, which pairs EVERY i with EVERY acc at that pc.
//
//   real states at pc4:  (i,acc) = (0,0) (1,1)
//   rebuilt by join:              (0,0) (0,1) (1,0) (1,1)   <- 2 spurious
//
// Sound (no real state is lost) but imprecise. i stays within 0..10, but
// acc is no longer tied to i's progress, so it grows forever.
// .limitsize cuts it off.

.decl accv(pc:number, v:number)
.decl ival(pc:number, v:number)

// rebuild states by joining the columns on pc
.decl sumn(pc:number, i:number, a:number) inline
sumn(pc, i, a) :- accv(pc, a), ival(pc, i).

accv(1,0). ival(1,0).

accv(2,a),   ival(2,i)   :- sumn(1,i,a).         // L1 -> L2
accv(3,a),   ival(3,i)   :- sumn(2,i,a), i < 10. // loop guard
accv(4,a+i), ival(4,i)   :- sumn(3,i,a).         // acc += i
accv(2,a),   ival(2,i+1) :- sumn(4,i,a).         // i++

.limitsize accv(n=20)
.output accv(IO=stdout)

// acc
// ===============
// 1       0
// 2       0
// 2       1
// 2       2
// 2       3
// 2       4
// 2       5
// 2       6
// 3       0
// 3       1
// 3       2
// 3       3
// 3       4
// 3       5
// 4       1
// 4       2
// 4       3
// 4       4
// 4       5
// 4       6
// ===============