/*
acc = 0;
for(i = 0; i < 10; i++){
  acc += i;
}
*/
.decl sumn(i : number, acc : number)
sumn(0,0).
sumn(i+1, s + i) :- sumn(i,s), i < 10.
.output sumn(IO=stdout)

// sumn
// ===============
// 0       0
// 1       0
// 2       1
// 3       3
// 4       6
// 5       10
// 6       15
// 7       21
// 8       28
// 9       36
// 10      45
// ===============

/*
// L1
acc = 0;
i = 0;
//L2
while(i < 10){
  // L3
  acc += i;
  // L4
  i++;
}
//L5
*/

.decl sumn_pc(pc : number, i : number, acc : number)
sumn_pc(1,0,0).
sumn_pc(2,i,acc) :- sumn_pc(1,i,acc).
sumn_pc(3,i,acc) :- sumn_pc(2,i,acc), i < 10.
sumn_pc(4,i,acc+i) :- sumn_pc(3,i,acc).
sumn_pc(2,i+1,acc):- sumn_pc(4,i,acc).

.output sumn_pc(IO=stdout)

// sumn_pc
