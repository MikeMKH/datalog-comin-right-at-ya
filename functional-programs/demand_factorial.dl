.decl _factorial(n : unsigned)
.decl factorial(n : unsigned, res : unsigned)
factorial(0,1).
_factorial(n-1) :- _factorial(n), n > 0. // demand propagation
factorial(n+1, (n + 1) * m) :- _factorial(n+1), factorial(n, m).

_factorial(12).
.output factorial(IO=stdout)

// factorial
// ===============
// 0       1
// 1       1
// 2       2
// 3       6
// 4       24
// 5       120
// 6       720
// 7       5040
// 8       40320
// 9       362880
// 10      3628800
// 11      39916800
// 12      479001600
// ===============