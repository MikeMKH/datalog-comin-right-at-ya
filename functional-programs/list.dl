.comp List<A>{
  .type t = [hd : A, tl : t]
  .decl _length(l : t)
  .decl length(l : t, res : unsigned)
  
  _length(tl) :- _length([_hd,tl]).
  length(nil,0).
  length([hd,tl], n+1) :- _length([hd,tl]), length(tl,n).

  .decl _nth(l : t, n : unsigned)
  .decl nth(l : t, n : unsigned , res : A)
  _nth(tl, n - 1) :- _nth([_hd,tl], n), n > 0.
  nth([hd,tl],0,hd) :- _nth([hd,tl], 0).
  nth([hd,tl], n, res):- _nth([hd, tl], n), nth(tl, n-1, res).

  .decl _rev(l : t)
  .decl __rev(l : t, rem : t, acc : t)
  .decl rev(l : t, res : t)
  __rev(l, l, nil) :- _rev(l).
  __rev(l, tl, [hd,acc]) :- __rev(l, [hd, tl], acc).
  rev(l, acc) :- __rev(l, nil, acc).

  .decl _append(x : t, y : t)
  .decl append(x : t, y : t, z : t)
  _append(tl, y) :- _append([_hd, tl], y).
  append(nil, y, y) :- _append(nil, y).
  append([hd,tl], y, [hd, z]) :- _append([hd,tl], y), append(tl, y, z).

  .decl _mem(x : A, l : t)
  .decl mem(x : A, l : t, res : number)
  mem(x, nil, 0) :- _mem(x, nil).
  mem(x, [hd,tl], 1) :- _mem(x, [hd,tl]), x = hd.
  _mem(x, tl) :- _mem(x, [hd,tl]), x != hd.
  mem(x, [hd,tl], res) :- _mem(x, [hd,tl]), x != hd, mem(x, tl, res).
}

.init Ints = List<unsigned>
.init Syms = List<symbol>

// --- length ---
Ints._length([10,[20,[30,nil]]]).
Syms._length(["a",["b",["c",nil]]]).

// --- nth: element at index n ---
Ints._nth([10,[20,[30,nil]]], 2).
Syms._nth(["a",["b",["c",nil]]], 2).

// --- rev ---
Ints._rev([10,[20,[30,nil]]]).
Syms._rev(["a",["b",["c",nil]]]).

// --- append ---
Ints._append([1,[2,nil]], [3,nil]).
Syms._append(["a",["b",nil]], ["c",nil]).

// --- mem: is x in the list? (1 = yes, 0 = no) ---
Syms._mem("b", ["a",["b",["c",nil]]]).
Syms._mem("z", ["a",["b",["c",nil]]]).

.output Ints.length(IO=stdout)
.output Syms.length(IO=stdout)
---------------
Ints.length
===============
nil     0
[30, nil]       1
[20, [30, nil]] 2
[10, [20, [30, nil]]]   3
===============
---------------
Syms.nth
===============
[c, nil]        0       c
[b, [c, nil]]   1       c
[a, [b, [c, nil]]]      2       c
===============

.output Ints.nth(IO=stdout)
.output Syms.nth(IO=stdout)
---------------
Ints.nth
===============
[30, nil]       0       30
[20, [30, nil]] 1       30
[10, [20, [30, nil]]]   2       30
===============
---------------
Syms.length
===============
nil     0
[c, nil]        1
[b, [c, nil]]   2
[a, [b, [c, nil]]]      3
===============

.output Ints.rev(IO=stdout)
.output Syms.rev(IO=stdout)
---------------
Ints.rev
===============
[10, [20, [30, nil]]]   [30, [20, [10, nil]]]
===============
---------------
Syms.rev
===============
[a, [b, [c, nil]]]      [c, [b, [a, nil]]]
===============

.output Ints.append(IO=stdout)
.output Syms.append(IO=stdout)
---------------
Ints.append
===============
nil     [3, nil]        [3, nil]
[2, nil]        [3, nil]        [2, [3, nil]]
[1, [2, nil]]   [3, nil]        [1, [2, [3, nil]]]
===============
---------------
Syms.append
===============
nil     [c, nil]        [c, nil]
[b, nil]        [c, nil]        [b, [c, nil]]
[a, [b, nil]]   [c, nil]        [a, [b, [c, nil]]]
===============

.output Syms.mem(IO=stdout)
---------------
Syms.mem
===============
b       [b, [c, nil]]   1
b       [a, [b, [c, nil]]]      1
z       nil     0
z       [c, nil]        0
z       [b, [c, nil]]   0
z       [a, [b, [c, nil]]]      0
===============