// $Lit(1) 1
// $Lit(2) 2
// $Add($Lit(1), $Lit(2))  3
// $Lit(3) 3
// $Add($Add($Lit(1), $Lit(2)), $Lit(3))   6
// $Lit(4) 4
// $Lit(5) 5
// $Lit(6) 6
// $Add($Lit(5), $Lit(6))  11
// $Add($Lit(4), $Add($Lit(5), $Lit(6)))   15
